@startuml NutriSense - Activity & Wearable Sync Database Diagram

skinparam linetype ortho
hide circle
hide methods

!define TABLE(name,desc) entity name as "desc" << (T, #AADDFF) >>
!define PK(x) <u>x</u>
!define FK(x) <i>x</i>

TABLE(wearable_connections, "wearable_connections") {
  PK(id) : INT AUTO_INCREMENT
  --
  FK(user_id) : INT NOT NULL
  provider : VARCHAR(50) NOT NULL
  status : VARCHAR(20) NOT NULL
  auto_sync_enabled : TINYINT(1) NOT NULL DEFAULT FALSE
  authorized_at : DATETIME NOT NULL
  access_token : VARCHAR(2048)
  refresh_token : VARCHAR(512)
  token_expires_at : DATETIME
  last_synced_at : DATETIME
  created_at : DATETIME
  updated_at : DATETIME
}

TABLE(activity_logs, "activity_logs") {
  PK(id) : INT AUTO_INCREMENT
  --
  FK(user_id) : INT NOT NULL
  date : VARCHAR(10) NOT NULL
  activity_type : VARCHAR(50) NOT NULL
  duration_minutes : INT NOT NULL
  calories_burned : DECIMAL(10,2) NOT NULL
  intensity : VARCHAR(10) NOT NULL
  source : VARCHAR(20) NOT NULL
  logged_at : DATETIME NOT NULL
  created_at : DATETIME
  updated_at : DATETIME
}

' Constraints
note right of wearable_connections
  INDEX (user_id, provider)
  [ix_wearable_connections_user_provider]
  user_id -> IAM users.id
  (logical ref, cross bounded-context,
   no DB-level FK)
end note

note right of activity_logs
  INDEX (user_id, date)
  [ix_activity_logs_user_date]
  user_id -> IAM users.id
  (logical ref, cross bounded-context,
   no DB-level FK)
end note

' Relationships
' Both aggregates are independent and are keyed by user_id
' (each references IAM users). There is NO FK between them in the backend.

@enduml
