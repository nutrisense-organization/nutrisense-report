@startuml
skinparam monochrome false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho

package "analytics-reporting/application [stub]" {
  class useAnalyticsReportingStore <<store>>
}

package "analytics-reporting/infrastructure [stub]" {
  class PdfExportService <<service>>
}

package "analytics-reporting/presentation/routes" {
  class AnalyticsReportingRoutes <<router>> {
    - analyticsReportingRoutes: RouteRecordRaw[]
  }
}

package "analytics-reporting/presentation/views" {
  class DashboardView <<view>>
  class AnalyticsView <<view>>
}

package "analytics-reporting/presentation/components" {
  class KpiCardComponent <<component>> {
    - label: string
    - value: string|number
    - unit: string
    - icon: string
    - color: string
    - loading: boolean
  }
  class MacroDonutChartComponent <<component>> {
    - proteinG: number
    - carbsG: number
    - fatG: number
    - proteinLabel: string
    - carbsLabel: string
    - fatLabel: string
  }
}

AnalyticsReportingRoutes ..> DashboardView : registers >
AnalyticsReportingRoutes ..> AnalyticsView : registers >

DashboardView o--> useAnalyticsReportingStore : uses >
AnalyticsView o--> useAnalyticsReportingStore : uses >
AnalyticsView ..> PdfExportService : exports via >

' NOTE: KpiCardComponent and MacroDonutChartComponent are defined in this BC's
' presentation layer but are NOT used by DashboardView or AnalyticsView — both
' views render their KPI cards and donut charts with inline markup/Chart.js
' instead. KpiCardComponent is actually consumed cross-context by
' ActivityView (activity-wearable BC); MacroDonutChartComponent is currently unused anywhere.

@enduml
